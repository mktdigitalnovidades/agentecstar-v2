# Define index.html como arquivo padrão (prioridade sobre index.php do WordPress)
DirectoryIndex index.html index.php

# React SPA — redireciona todas as rotas para index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não redirecionar arquivos reais (js, css, imagens, fontes, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f

  # Exceção: Não redirecionar apenas a pasta /blog/imagens (assets estáticos dentro de /blog/)
  # Redireciona /blog, /blog/post-slug, /servicos/slug etc. para o React
  RewriteCond %{REQUEST_URI} !^/blog/[^/]+\.(jpg|jpeg|png|gif|webp|svg|ico|pdf)$
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/lovable-uploads/

  # Tudo mais vai para o index.html do React (incluindo /blog mesmo sendo pasta física)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache de assets por 1 ano (melhora performance e nota no Google)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compressão GZIP (melhora velocidade de carregamento)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
