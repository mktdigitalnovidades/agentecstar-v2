# ═══════════════════════════════════════════════════════════════
# AgentecStar — .htaccess principal
# ═══════════════════════════════════════════════════════════════

# Define index.html como arquivo padrão (prioridade sobre index.php do WordPress)
DirectoryIndex index.html index.php

# ─── HSTS: força HTTPS em todos os subdomínios (Semrush: subdomains sem HSTS) ─
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Proteção extra de segurança
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ─── React SPA — redireciona todas as rotas para index.html ───────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não redirecionar arquivos reais (js, css, imagens, fontes, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f

  # Exceção: não redirecionar apenas assets estáticos dentro de /blog/
  RewriteCond %{REQUEST_URI} !^/blog/[^/]+\.(jpg|jpeg|png|gif|webp|svg|ico|pdf)$
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/lovable-uploads/

  # Tudo mais vai para o index.html do React (incluindo /blog mesmo sendo pasta física)
  RewriteRule ^ index.html [L]
</IfModule>

# ─── Cache de assets por 1 ano (melhora performance e nota no Google) ─────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpg                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType application/font-woff2   "access plus 1 year"
</IfModule>

# ─── Compressão GZIP (melhora velocidade de carregamento) ─────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>
